# the project survives a restart: SAVE, then autosave after a quiet moment
tap HOME
spin K1 3
expect par0 3
tap SAVE
expect store_writes 1
expect dirty 0
reboot
expect par0 3
# a change saves itself four seconds after the last touch, once the tines are quiet
spin K4 -30
expect par3 25
expect dirty 1
wait 3000
expect store_writes 1
wait 2000
expect store_writes 2
expect dirty 0
reboot
expect par3 25
# a scale and a key on the Tine layout: A minor pentatonic, A3 in the middle, C4 right of it
tap SEL
spin K2 3
spin K3 9
expect par17 3
expect par18 9
expect white7 5700
expect white8 6000
tap SAVE
reboot
expect par18 9
# live grains don't hold autosave back (they never stop spawning while Grains is up)...
tap LFO
spin K1 30
expect par12 30
wait 6000
expect dirty 0
# ...frozen ones do: an erase would cut the drone
tapkey w7
tap PLAY
expect frozen 3
tap HOME
spin K2 5
wait 6000
expect dirty 1
tap PLAY
wait 6000
expect dirty 0
# a project saved by the version before Color and Pattern (format 1): its settings kept, the new ones at
# their defaults (Glide 30, not the 0 its spare bytes hold; Tempo 96)
oldproject
reboot
expect par0 2
expect par36 30
expect par35 96
expect par30 0
